{
  "name": "dsh-screenshot",
  "version": "2.0.0",
  "description": "Screenshot plugin for DeepSeek Harness: full-screen region picker, annotations, copy or download (Windows).",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "dsh-bundle",
    "screenshot",
    "annotation",
    "windows"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/wuyakun23/dsh-screenshot.git"
  },
  "homepage": "https://github.com/wuyakun23/dsh-screenshot#readme",
  "engines": {
    "dsh": ">=0.2.1-rc.5"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "index": "node scripts/build-index.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}

